{
  "name": "supply-chain-s2s-agent",
  "version": "1.0.0",
  "private": true,
  "description": "S2S shipment exception webhook with LangChain and optional Azure OpenAI reasoning",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "token": "tsx src/token.ts",
    "replay": "tsx src/replay.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@langchain/core": "^1.2.4",
    "@langchain/openai": "^1.5.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
